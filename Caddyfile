# Konfigurasi Caddy Reverse Proxy dengan HTTPS Otomatis
# Ganti multigrade.sdnkandangan1.sch.id dengan domain sekolah Anda.
multigrade.sdnkandangan1.sch.id {
    reverse_proxy app:3005

    # Security headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Log access
    log {
        output file /data/caddy_access.log {
            roll_size 10mb
            roll_keep 5
        }
    }
}
